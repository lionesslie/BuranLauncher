{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buran Launcher",
  "version": "1.0.0",
  "identifier": "com.buranlauncher.app",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "category": "Game",
    "shortDescription": "Buran Launcher - Minecraft başlatıcı",
    "longDescription": "Buran Launcher - Minecraft başlatıcı",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../assets": "assets",
      "../locales": "locales"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "Russian", "English"]
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}